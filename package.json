{
  "name": "clear-markdown-reader",
  "displayName": "Clear Markdown Reader",
  "description": "Listen to Markdown with a natural neural voice that runs on your computer. The editor highlights each sentence and word as it is read, tables and lists sound natural, and small podcast-style controls sit in the status bar.",
  "version": "0.3.0",
  "publisher": "orexii",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/Orexii/clear-markdown-reader.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "read aloud",
    "text to speech",
    "tts",
    "neural voice",
    "kokoro",
    "accessibility",
    "tables",
    "offline"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "clearMarkdown.read",
        "title": "Read Aloud",
        "category": "Clear Markdown",
        "icon": "$(unmute)"
      },
      {
        "command": "clearMarkdown.readFromTop",
        "title": "Read Aloud from the Start",
        "category": "Clear Markdown"
      },
      {
        "command": "clearMarkdown.readFromCursor",
        "title": "Read Aloud from Cursor",
        "category": "Clear Markdown"
      },
      {
        "command": "clearMarkdown.readSelection",
        "title": "Read Selection Aloud",
        "category": "Clear Markdown"
      },
      {
        "command": "clearMarkdown.togglePlay",
        "title": "Play or Pause Reading",
        "category": "Clear Markdown"
      },
      {
        "command": "clearMarkdown.play",
        "title": "Resume Reading",
        "category": "Clear Markdown",
        "icon": "$(play)"
      },
      {
        "command": "clearMarkdown.pause",
        "title": "Pause Reading",
        "category": "Clear Markdown",
        "icon": "$(debug-pause)"
      },
      {
        "command": "clearMarkdown.stop",
        "title": "Stop Reading",
        "category": "Clear Markdown",
        "icon": "$(primitive-square)"
      },
      {
        "command": "clearMarkdown.skipBack",
        "title": "Skip Back",
        "category": "Clear Markdown"
      },
      {
        "command": "clearMarkdown.skipForward",
        "title": "Skip Forward",
        "category": "Clear Markdown"
      },
      {
        "command": "clearMarkdown.previousSentence",
        "title": "Previous Sentence",
        "category": "Clear Markdown"
      },
      {
        "command": "clearMarkdown.nextSentence",
        "title": "Next Sentence",
        "category": "Clear Markdown"
      },
      {
        "command": "clearMarkdown.previousParagraph",
        "title": "Previous Paragraph",
        "category": "Clear Markdown"
      },
      {
        "command": "clearMarkdown.nextParagraph",
        "title": "Next Paragraph",
        "category": "Clear Markdown"
      },
      {
        "command": "clearMarkdown.faster",
        "title": "Read Faster",
        "category": "Clear Markdown"
      },
      {
        "command": "clearMarkdown.slower",
        "title": "Read Slower",
        "category": "Clear Markdown"
      },
      {
        "command": "clearMarkdown.chooseSpeed",
        "title": "Choose Reading Speed",
        "category": "Clear Markdown"
      },
      {
        "command": "clearMarkdown.chooseVoice",
        "title": "Choose Voice",
        "category": "Clear Markdown"
      },
      {
        "command": "clearMarkdown.backToReading",
        "title": "Scroll Back to the Reading Position",
        "category": "Clear Markdown"
      },
      {
        "command": "clearMarkdown.showPlayer",
        "title": "Show Player",
        "category": "Clear Markdown"
      },
      {
        "command": "clearMarkdown.refreshReading",
        "title": "Update Reading After Edits",
        "category": "Clear Markdown"
      },
      {
        "command": "clearMarkdown.describeBlock",
        "title": "Describe Table or Code with Copilot",
        "category": "Clear Markdown",
        "icon": "$(sparkle)"
      },
      {
        "command": "clearMarkdown.restoreBlock",
        "title": "Use the Original Narration",
        "category": "Clear Markdown"
      },
      {
        "command": "clearMarkdown.installNaturalVoice",
        "title": "Download Natural Voice",
        "category": "Clear Markdown"
      },
      {
        "command": "clearMarkdown.removeNaturalVoice",
        "title": "Remove Downloaded Natural Voice",
        "category": "Clear Markdown"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "clearMarkdown.read",
          "when": "editorLangId == markdown && resource not in clearMarkdown.readingResources",
          "group": "navigation"
        },
        {
          "command": "clearMarkdown.pause",
          "when": "resource in clearMarkdown.readingResources && clearMarkdown.playing",
          "group": "navigation@1"
        },
        {
          "command": "clearMarkdown.play",
          "when": "resource in clearMarkdown.readingResources && !clearMarkdown.playing",
          "group": "navigation@1"
        },
        {
          "command": "clearMarkdown.stop",
          "when": "resource in clearMarkdown.readingResources",
          "group": "navigation@2"
        }
      ],
      "view/title": [
        {
          "command": "clearMarkdown.stop",
          "when": "view == clearMarkdown.player && clearMarkdown.playerActive",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "clearMarkdown.readSelection",
          "when": "editorLangId == markdown && editorHasSelection",
          "group": "navigation@1"
        },
        {
          "command": "clearMarkdown.readFromCursor",
          "when": "editorLangId == markdown && !editorHasSelection",
          "group": "navigation@1"
        }
      ],
      "explorer/context": [
        {
          "command": "clearMarkdown.read",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "clearMarkdown.togglePlay",
          "when": "clearMarkdown.playerActive || editorLangId == markdown"
        },
        {
          "command": "clearMarkdown.play",
          "when": "clearMarkdown.playerActive"
        },
        {
          "command": "clearMarkdown.pause",
          "when": "clearMarkdown.playerActive"
        },
        {
          "command": "clearMarkdown.stop",
          "when": "clearMarkdown.playerActive"
        },
        {
          "command": "clearMarkdown.skipBack",
          "when": "clearMarkdown.playerActive"
        },
        {
          "command": "clearMarkdown.skipForward",
          "when": "clearMarkdown.playerActive"
        },
        {
          "command": "clearMarkdown.previousSentence",
          "when": "clearMarkdown.playerActive"
        },
        {
          "command": "clearMarkdown.nextSentence",
          "when": "clearMarkdown.playerActive"
        },
        {
          "command": "clearMarkdown.previousParagraph",
          "when": "clearMarkdown.playerActive"
        },
        {
          "command": "clearMarkdown.nextParagraph",
          "when": "clearMarkdown.playerActive"
        },
        {
          "command": "clearMarkdown.faster",
          "when": "clearMarkdown.playerActive"
        },
        {
          "command": "clearMarkdown.slower",
          "when": "clearMarkdown.playerActive"
        },
        {
          "command": "clearMarkdown.backToReading",
          "when": "clearMarkdown.playerActive"
        },
        {
          "command": "clearMarkdown.refreshReading",
          "when": "clearMarkdown.playerActive"
        },
        {
          "command": "clearMarkdown.describeBlock",
          "when": "clearMarkdown.playerActive"
        },
        {
          "command": "clearMarkdown.restoreBlock",
          "when": "false"
        },
        {
          "command": "clearMarkdown.read",
          "when": "editorLangId == markdown"
        },
        {
          "command": "clearMarkdown.readFromTop",
          "when": "editorLangId == markdown"
        },
        {
          "command": "clearMarkdown.readFromCursor",
          "when": "editorLangId == markdown"
        },
        {
          "command": "clearMarkdown.readSelection",
          "when": "editorLangId == markdown && editorHasSelection"
        }
      ]
    },
    "keybindings": [
      {
        "command": "clearMarkdown.readFromCursor",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "editorTextFocus && editorLangId == markdown && !findWidgetVisible"
      },
      {
        "command": "clearMarkdown.togglePlay",
        "key": "ctrl+alt+p",
        "mac": "ctrl+cmd+p",
        "when": "clearMarkdown.playerActive"
      },
      {
        "command": "clearMarkdown.skipBack",
        "key": "ctrl+alt+,",
        "mac": "ctrl+cmd+,",
        "when": "clearMarkdown.playerActive"
      },
      {
        "command": "clearMarkdown.skipForward",
        "key": "ctrl+alt+.",
        "mac": "ctrl+cmd+.",
        "when": "clearMarkdown.playerActive"
      }
    ],
    "colors": [
      {
        "id": "clearMarkdown.readingBackground",
        "description": "Background of the sentence being read aloud in the editor.",
        "defaults": {
          "dark": "#3794ff26",
          "light": "#0066bf1c",
          "highContrast": "#3794ff40",
          "highContrastLight": "#0066bf30"
        }
      },
      {
        "id": "clearMarkdown.readingWordBackground",
        "description": "Background of the word being spoken in the editor.",
        "defaults": {
          "dark": "#3794ff70",
          "light": "#0066bf45",
          "highContrast": "#3794ff90",
          "highContrastLight": "#0066bf70"
        }
      }
    ],
    "configuration": {
      "title": "Clear Markdown Reader",
      "properties": {
        "clearMarkdown.engine": {
          "type": "string",
          "enum": [
            "natural",
            "system"
          ],
          "default": "natural",
          "enumDescriptions": [
            "Natural neural voice (Kokoro) that runs on this computer after a one-time download.",
            "Voices installed in the operating system."
          ],
          "description": "Which speech engine reads documents."
        },
        "clearMarkdown.naturalVoice": {
          "type": "string",
          "enum": [
            "af_heart",
            "af_bella",
            "af_nicole",
            "bf_emma",
            "am_michael",
            "am_fenrir",
            "am_puck",
            "af_aoede",
            "af_kore",
            "af_sarah",
            "bm_george",
            "bm_fable",
            "bf_isabella",
            "af_alloy",
            "af_nova",
            "af_sky",
            "bm_lewis",
            "af_jessica",
            "af_river",
            "am_echo",
            "am_eric",
            "am_liam",
            "am_onyx",
            "bf_alice",
            "bf_lily",
            "bm_daniel",
            "am_santa",
            "am_adam"
          ],
          "enumDescriptions": [
            "Heart: American female, grade A (recommended)",
            "Bella: American female, grade A-",
            "Nicole: American female, grade B-",
            "Emma: British female, grade B-",
            "Michael: American male, grade C+",
            "Fenrir: American male, grade C+",
            "Puck: American male, grade C+",
            "Aoede: American female, grade C+",
            "Kore: American female, grade C+",
            "Sarah: American female, grade C+",
            "George: British male, grade C",
            "Fable: British male, grade C",
            "Isabella: British female, grade C",
            "Alloy: American female, grade C",
            "Nova: American female, grade C",
            "Sky: American female, grade C-",
            "Lewis: British male, grade D+",
            "Jessica: American female, grade D",
            "River: American female, grade D",
            "Echo: American male, grade D",
            "Eric: American male, grade D",
            "Liam: American male, grade D",
            "Onyx: American male, grade D",
            "Alice: British female, grade D",
            "Lily: British female, grade D",
            "Daniel: British male, grade D",
            "Santa: American male, grade D-",
            "Adam: American male, grade F+"
          ],
          "default": "af_heart",
          "description": "Natural voice. Grades are the model authors' quality estimates; Heart is the best."
        },
        "clearMarkdown.naturalQuality": {
          "type": "string",
          "enum": [
            "best",
            "compact"
          ],
          "default": "best",
          "enumDescriptions": [
            "Full-precision model (326 MB download): best sound.",
            "Quantized model (92 MB download): smaller and slightly faster, with a small loss of quality."
          ],
          "description": "Which natural voice model to download and use."
        },
        "clearMarkdown.systemVoice": {
          "type": "string",
          "default": "",
          "description": "Operating-system voice used by the system engine. Empty uses the default voice."
        },
        "clearMarkdown.voice": {
          "type": "string",
          "default": "",
          "deprecationMessage": "Replaced by clearMarkdown.systemVoice.",
          "markdownDeprecationMessage": "Replaced by `#clearMarkdown.systemVoice#`."
        },
        "clearMarkdown.rate": {
          "type": "number",
          "enum": [
            0.5,
            0.75,
            1,
            1.25,
            1.5,
            1.75,
            2
          ],
          "default": 1,
          "description": "Reading speed, from half to double speed in quarter steps. Pitch stays natural."
        },
        "clearMarkdown.skipBackSeconds": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 120,
          "description": "Seconds to skip back (back button, ← or J in the player, Ctrl+Alt+, anywhere)."
        },
        "clearMarkdown.skipForwardSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 300,
          "description": "Seconds to skip forward (forward button, → or L in the player, Ctrl+Alt+. anywhere)."
        },
        "clearMarkdown.tableMode": {
          "type": "string",
          "enum": [
            "rows",
            "columns"
          ],
          "default": "rows",
          "enumDescriptions": [
            "Each row with its column names, e.g. \"Mail. State: Ready.\"",
            "One column at a time, naming each row."
          ],
          "description": "How tables are read."
        },
        "clearMarkdown.codeBlocks": {
          "type": "string",
          "enum": [
            "announce",
            "read",
            "skip"
          ],
          "default": "announce",
          "enumDescriptions": [
            "Say the language and line count.",
            "Read the code line by line.",
            "Show the code without speaking it."
          ],
          "description": "How fenced code blocks are read."
        },
        "clearMarkdown.followInEditor": {
          "type": "boolean",
          "default": true,
          "description": "Scroll the editor to keep the sentence being read in view. Scrolling away pauses this until you scroll back."
        },
        "clearMarkdown.highlightWords": {
          "type": "boolean",
          "default": true,
          "description": "Highlight each word in the editor as it is spoken, as well as the sentence."
        },
        "clearMarkdown.pronunciations": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "How to say particular words, e.g. `{ \"Kusto\": \"kuss toe\", \"nginx\": \"engine x\", \"Rakeem\": \"/ɹɑːkˈiːm/\" }`. Values in slashes are IPA phonemes (natural voice only). Workspace settings can share a dictionary with your team."
        },
        "clearMarkdown.threads": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 32,
          "description": "CPU threads for the natural voice. 0 picks half the processor threads, up to 8."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "clearMarkdown.player",
          "name": "Read Aloud",
          "contextualTitle": "Clear Markdown Reader",
          "icon": "media/icon.svg",
          "visibility": "collapsed"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run check && npm run build",
    "build": "node tools/build.mjs",
    "check": "tsc --noEmit",
    "test": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\" && tsc && node --test out/test/*.test.js",
    "package": "node tools/package.mjs"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "onnxruntime-node": "1.23.2",
    "phonemizer": "1.2.1"
  },
  "overrides": {
    "@vscode/vsce": {
      "@azure/identity": "4.13.0",
      "uuid": "^11.1.1"
    },
    "onnxruntime-node": {
      "adm-zip": "^0.6.1"
    }
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "playwright-core": "1.64.1",
    "typescript": "^5.8.0"
  }
}
